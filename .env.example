# Optional launcher settings. Copy this file to .env and fill your own values.
# The launcher requires all three values. Never commit a real API key.
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=your-model-name

# Optional Cerebras evaluation scripts only.
CEREBRAS_API_KEY=
